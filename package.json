{
  "name": "taskflow",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"pnpm --filter @taskflow/api dev\" \"pnpm --filter @taskflow/web dev\"",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "db:setup": "pnpm --filter @taskflow/api db:setup"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
